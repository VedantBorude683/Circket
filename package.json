{
  "name": "voicescore",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:replay": "pnpm --filter @voicescore/testkit build && node packages/testkit/dist/replay-cli.js",
    "eval:voice": "pnpm --filter @voicescore/schemas build && pnpm --filter @voicescore/parser build && node evals/voice/run.ts",
    "typecheck": "tsc -b",
    "format": "prettier --check .",
    "pretest": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
